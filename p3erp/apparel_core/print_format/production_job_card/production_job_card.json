{
 "doctype": "Print Format",
 "name": "Production Job Card",
 "module": "Apparel Core",
 "doc_type": "Apparel Order Spec",
 "print_format_type": "Jinja",
 "standard": "Yes",
 "disabled": 0,
 "custom_format": 1,
 "html": "<div class=\"job-card-wrapper\" style=\"font-family: Arial, sans-serif; padding: 15px; color: #0f172a;\">\n    <style>\n        @page { size: A4; margin: 10mm; }\n        .hover-zoom { transition: transform 0.2s ease; cursor: pointer; }\n        .hover-zoom:hover { transform: scale(1.8); z-index: 1000; position: relative; }\n    </style>\n\n    <div style=\"display: flex; justify-content: space-between; border-bottom: 2px solid #0f172a; padding-bottom: 8px; margin-bottom: 12px;\">\n        <div>\n            <h2 style=\"margin: 0; font-size: 20px; font-weight: 800; color: #0f172a;\">PRODUCTION JOB CARD</h2>\n            <span style=\"font-size: 11px; color: #64748b;\">P3ERP Apparel Manufacturing System</span>\n        </div>\n        <div style=\"text-align: right;\">\n            <h3 style=\"margin: 0; font-size: 16px; color: #0284c7;\">{{ doc.name }}</h3>\n            <span style=\"font-size: 11px;\">Order Date: {{ doc.creation[:10] }}</span>\n        </div>\n    </div>\n\n    <div style=\"background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px; padding: 10px; margin-bottom: 15px; display: flex; justify-content: space-between; font-size: 12px;\">\n        <div><strong>Sales Order:</strong> {{ doc.sales_order }}</div>\n        <div><strong>Customer:</strong> {{ doc.customer }}</div>\n        <div><strong>Product:</strong> {{ doc.product_type }}</div>\n        <div><strong>Total Qty:</strong> <span style=\"font-weight: 700; color: #0284c7;\">{{ doc.total_qty }} Pcs</span></div>\n    </div>\n\n    <div style=\"display: flex; gap: 15px;\">\n        <div style=\"flex: 1; border: 1px solid #cbd5e1; border-radius: 6px; padding: 10px;\">\n            <h4 style=\"margin-top: 0; font-size: 13px; font-weight: 700; border-bottom: 1px solid #e2e8f0; padding-bottom: 4px;\">PRINT & DESIGN SPECS</h4>\n            <ul style=\"list-style: none; padding-left: 0; font-size: 12px; line-height: 1.8;\">\n                <li><strong>Fabric:</strong> {{ doc.fabric or 'N/A' }}</li>\n                <li><strong>Collar Style:</strong> {{ doc.collar_type or 'Standard' }}</li>\n                <li><strong>Buttons:</strong> {{ doc.button_qty or '0' }} Buttons</li>\n                <li><strong>Sublimation:</strong> {{ doc.print_sublimation_type }}</li>\n                <li><strong>Solid Panel:</strong> {{ doc.solid_colour or 'N/A' }}</li>\n            </ul>\n\n            <div style=\"margin-top: 10px; text-align: center; border: 1px dashed #2563eb; padding: 8px; border-radius: 6px; background: #fafafa;\">\n                <span style=\"font-size: 10px; font-weight: 700; color: #2563eb; display: block; margin-bottom: 4px;\">ARTWORK PREVIEW (Hover/Zoom)</span>\n                {% if doc.artwork_file %}\n                    <img src=\"{{ doc.artwork_file }}\" class=\"hover-zoom\" style=\"max-width: 100%; max-height: 180px; object-fit: contain;\" />\n                {% else %}\n                    <span style=\"color: #94a3b8; font-size: 11px;\">No Artwork Attached</span>\n                {% endif %}\n            </div>\n        </div>\n\n        <div style=\"flex: 1.3; border: 1px solid #cbd5e1; border-radius: 6px; padding: 10px;\">\n            <h4 style=\"margin-top: 0; font-size: 13px; font-weight: 700; border-bottom: 1px solid #e2e8f0; padding-bottom: 4px;\">CUTTING & SEWING BREAKDOWN</h4>\n            <div style=\"font-size: 11px; margin-top: 8px;\">\n                {% if doc.size_matrix %}\n                <table class=\"table table-bordered\" style=\"font-size: 10px; text-align: center;\">\n                    <thead>\n                        <tr style=\"background: #0f172a; color: #fff;\">\n                            <th>Size</th>\n                            <th>Half Sleeve</th>\n                            <th>Full Sleeve</th>\n                            <th>Sleeveless</th>\n                            <th>Total</th>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        {% for row in doc.size_matrix %}\n                        <tr>\n                            <td>{{ row.size_code }}</td>\n                            <td>{{ row.hs_qty or 0 }}</td>\n                            <td>{{ row.fs_qty or 0 }}</td>\n                            <td>{{ row.sl_qty or 0 }}</td>\n                            <td style=\"font-weight: 700;\">{{ row.total_qty or 0 }}</td>\n                        </tr>\n                        {% endfor %}\n                    </tbody>\n                    <tfoot>\n                        <tr style=\"background: #e2e8f0; font-weight: 700;\">\n                            <td colspan=\"4\">Grand Total</td>\n                            <td>{{ doc.total_qty }} Pcs</td>\n                        </tr>\n                    </tfoot>\n                </table>\n                {% else %}\n                <span style=\"color: #94a3b8;\">No size/sleeve breakdown recorded.</span>\n                {% endif %}\n            </div>\n\n            <h4 style=\"margin-top: 20px; font-size: 12px; font-weight: 700;\">DEPARTMENT SIGN-OFF</h4>\n            <table class=\"table table-bordered\" style=\"font-size: 10px; margin-top: 6px;\">\n                <tr><td>[  ] Sublimation / Printing</td><td>Sign: ____________</td></tr>\n                <tr><td>[  ] Cutting Floor</td><td>Sign: ____________</td></tr>\n                <tr><td>[  ] Sewing & Assembly</td><td>Sign: ____________</td></tr>\n                <tr><td>[  ] QC & Packaging</td><td>Sign: ____________</td></tr>\n            </table>\n        </div>\n    </div>\n\n    <div style=\"margin-top: 20px; border-top: 1px solid #cbd5e1; pt: 8px; font-size: 10px; color: #64748b; display: flex; justify-content: space-between;\">\n        <span>P3ERP Dynamic Engine Routing: {{ doc.bom_strategy }}</span>\n        <span>Page 1 of 1</span>\n    </div>\n</div>",
 "font_size": 12,
 "margin_top": 10,
 "margin_bottom": 10,
 "margin_left": 10,
 "margin_right": 10,
 "page_number": "Hide",
 "align_labels_right": 0,
 "line_breaks": 0,
 "show_section_headings": 0,
 "raw_printing": 0,
 "print_format_builder": 0
}
