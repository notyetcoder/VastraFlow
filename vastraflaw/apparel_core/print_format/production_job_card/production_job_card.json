{
 "doctype": "Print Format",
 "name": "Production Job Card",
 "module": "Apparel Core",
 "doc_type": "vastraflaw Order Book",
 "print_format_type": "Jinja",
 "standard": "Yes",
 "disabled": 0,
 "custom_format": 1,
 "html": "<div class=\"jc-wrapper\" style=\"font-family: 'Inter', Arial, sans-serif; color: #111417; padding: 4px;\">\n    <style>\n        @page { size: A4; margin: 10mm; }\n        .jc-wrapper .cube-row { display: flex; gap: 10px; flex-wrap: nowrap; margin-bottom: 4px; }\n        .jc-wrapper .cube { flex: 1; border: 1px solid #dfe3e6; border-radius: 6px; padding: 8px 10px;\n            text-align: center; background: #fafbfb; min-width: 0; }\n        .jc-wrapper .cube.cube-wide { flex: 1.6; background: #fff; border: 1.5px solid #111417; }\n        .jc-wrapper .cube .cube-k { font-size: 8.5px; font-weight: 800; text-transform: uppercase;\n            letter-spacing: .04em; color: #6b7580; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n        .jc-wrapper .cube .cube-v { font-size: 12px; font-weight: 700; overflow-wrap: break-word; }\n        .jc-wrapper .cube img { max-width: 100%; max-height: 46px; object-fit: contain; margin-bottom: 4px; border-radius: 3px; }\n        .jc-wrapper table.matrix-table, .jc-wrapper table.signoff-row {\n            width: 100%; border-collapse: collapse; font-size: 11px; }\n        .jc-wrapper table.matrix-table th, .jc-wrapper table.matrix-table td {\n            border: 1px solid #dfe3e6; padding: 5px 3px; text-align: center; }\n        .jc-wrapper table.matrix-table thead th {\n            background: #111417; color: #fff; font-weight: 700; font-size: 9.5px; text-transform: uppercase; }\n        .jc-wrapper table.matrix-table tfoot td { background: #f1f3f4; font-weight: 800; }\n        .jc-wrapper table.matrix-table td.grand { background: #eaf4fe; color: #2490ef; }\n        .jc-wrapper .section-label { font-size: 11px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;\n            border-bottom: 2px solid #111417; padding-bottom: 5px; margin: 14px 0 8px; }\n        .jc-wrapper .signoff-row { display: flex; justify-content: space-between; gap: 10px;\n            border: 1px solid #dfe3e6; border-radius: 6px; padding: 8px 12px; font-size: 10px; }\n        .jc-wrapper .signoff-item { display: flex; align-items: center; gap: 5px; white-space: nowrap; }\n        .jc-wrapper .checkbox { display: inline-block; width: 11px; height: 11px; border: 1.5px solid #111417;\n            border-radius: 2px; flex-shrink: 0; }\n    </style>\n\n    <!-- Header -->\n    <div style=\"display:flex; justify-content:space-between; align-items:flex-start; border-bottom:3px solid #111417; padding-bottom:12px; margin-bottom:12px;\">\n        <div>\n            <h1 style=\"font-size:20px; font-weight:800; margin:0; letter-spacing:-0.01em;\">PRODUCTION JOB CARD</h1>\n            <div style=\"font-size:10.5px; color:#6b7580; letter-spacing:.04em; text-transform:uppercase; margin-top:2px;\">\n                vastraflaw &middot; Apparel Manufacturing Floor Copy\n            </div>\n        </div>\n        <div style=\"text-align:right;\">\n            <div style=\"font-family:'JetBrains Mono', monospace; font-size:15px; font-weight:700; color:#2490ef;\">{{ doc.name }}</div>\n            <div style=\"font-size:10.5px; color:#6b7580; margin-top:3px;\">\n                Order: {{ doc.transaction_date }} &nbsp;&middot;&nbsp; Delivery: {{ doc.delivery_date }}\n            </div>\n        </div>\n    </div>\n\n    <!-- TOP: Artwork (large, upper-left, no hover) beside Customer/Address/Contact/Dates -->\n    <table style=\"width:100%; border-collapse:separate; border-spacing:14px 0; margin-bottom:6px;\">\n    <tr>\n        <td style=\"width:28%; vertical-align:top;\">\n            <div style=\"border:1.5px solid #111417; border-radius:6px; padding:8px; text-align:center; background:#fafbfb;\">\n                <div style=\"font-size:8.5px; font-weight:800; letter-spacing:.05em; text-transform:uppercase; color:#6b7580; margin-bottom:6px;\">Artwork</div>\n                {% if doc.artwork_file %}\n                <img src=\"{{ doc.artwork_file }}\" style=\"width:100%; height:auto; display:block; object-fit:contain; border:1px solid #dfe3e6; border-radius:3px;\" />\n                {% else %}\n                <div style=\"padding:26px 10px; color:#94a3b8; font-size:11px;\">No Artwork Attached</div>\n                {% endif %}\n            </div>\n        </td>\n        <td style=\"width:72%; vertical-align:top;\">\n            <div style=\"border:1px solid #dfe3e6; border-radius:6px; padding:12px; height:100%;\">\n                <div style=\"display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px;\">\n                    <div>\n                        <div style=\"font-size:15px; font-weight:800;\">{{ doc.customer }}</div>\n                        {% if doc.address_display %}\n                        <div style=\"font-size:10.5px; color:#6b7580; line-height:1.5;\">{{ doc.address_display }}</div>\n                        {% endif %}\n                        {% if doc.contact_display %}\n                        <div style=\"font-size:10.5px; color:#6b7580; line-height:1.5;\">{{ doc.contact_display }}</div>\n                        {% endif %}\n                    </div>\n                    <div style=\"text-align:right; background:#111417; color:#fff; border-radius:6px; padding:8px 14px;\">\n                        <div style=\"font-size:8.5px; text-transform:uppercase; color:#cfd3d7; font-weight:700;\">Total Qty</div>\n                        <div style=\"font-size:18px; font-weight:800; color:#7ec8ff;\">{{ doc.total_qty }} Pcs</div>\n                    </div>\n                </div>\n\n                <!-- Product name: bigger, bolder, highlighted, full name not code -->\n                <div style=\"background:#eaf4fe; border:1.5px solid #2490ef; border-radius:6px; padding:8px 12px; margin-bottom:8px;\">\n                    <span style=\"font-size:9px; text-transform:uppercase; color:#2490ef; font-weight:700; letter-spacing:.04em;\">Product</span>\n                    <div style=\"font-size:16px; font-weight:800; color:#111417;\">{{ doc.product_type_label or doc.product_type }}</div>\n                </div>\n\n                <table style=\"width:100%; border-collapse:collapse;\">\n                    <tr>\n                        <td style=\"border:1px solid #dfe3e6; padding:6px 10px; width:33%;\">\n                            <div style=\"font-size:8.5px; text-transform:uppercase; color:#6b7580; font-weight:700;\">Order Date</div>\n                            <div style=\"font-size:12px; font-weight:700;\">{{ doc.transaction_date }}</div>\n                        </td>\n                        <td style=\"border:1px solid #dfe3e6; padding:6px 10px; width:33%;\">\n                            <div style=\"font-size:8.5px; text-transform:uppercase; color:#6b7580; font-weight:700;\">Delivery Date</div>\n                            <div style=\"font-size:12px; font-weight:700;\">{{ doc.delivery_date }}</div>\n                        </td>\n                        <td style=\"border:1px solid #dfe3e6; padding:6px 10px; width:34%;\">\n                            <div style=\"font-size:8.5px; text-transform:uppercase; color:#6b7580; font-weight:700;\">Sales Order</div>\n                            <div style=\"font-size:12px; font-weight:700;\">{{ doc.sales_order or 'Not yet linked' }}</div>\n                        </td>\n                    </tr>\n                </table>\n            </div>\n        </td>\n    </tr>\n    </table>\n\n    <!-- GARMENT SPECS / STYLE - horizontal cubes -->\n    <p class=\"section-label\">Garment Specs / Style</p>\n    <div class=\"cube-row\">\n        <div class=\"cube\">\n            <div class=\"cube-k\">Fabric</div>\n            <div class=\"cube-v\">{{ doc.fabric_label or doc.fabric or 'N/A' }}</div>\n        </div>\n        <div class=\"cube cube-wide\">\n            <div class=\"cube-k\">Collar Type</div>\n            {% if doc.collar_image %}\n            <img src=\"{{ doc.collar_image }}\" />\n            {% endif %}\n            <div class=\"cube-v\">{{ doc.collar_label or doc.collar_type or 'Standard' }}</div>\n        </div>\n        <div class=\"cube\">\n            <div class=\"cube-k\">Stitching Type</div>\n            <div class=\"cube-v\">{{ doc.stitching or 'N/A' }}</div>\n        </div>\n        <div class=\"cube\">\n            <div class=\"cube-k\">Buttons</div>\n            <div class=\"cube-v\">{{ doc.button_qty or 0 }}</div>\n        </div>\n    </div>\n\n    <!-- SUBLIMATION - horizontal cubes -->\n    <p class=\"section-label\">Sublimation ({{ doc.sublimation_type }})</p>\n    <div class=\"cube-row\">\n        <div class=\"cube\">\n            <div class=\"cube-k\">Front</div>\n            <div class=\"cube-v\">{{ doc.front_print or '-' }}{% if doc.front_colour %}<br><span style=\"font-weight:400; font-size:10px;\">{{ doc.front_colour }}</span>{% endif %}</div>\n        </div>\n        <div class=\"cube\">\n            <div class=\"cube-k\">Back</div>\n            <div class=\"cube-v\">{{ doc.back_print or '-' }}{% if doc.back_colour %}<br><span style=\"font-weight:400; font-size:10px;\">{{ doc.back_colour }}</span>{% endif %}</div>\n        </div>\n        <div class=\"cube\">\n            <div class=\"cube-k\">Sleeves</div>\n            <div class=\"cube-v\">{{ doc.sleeve_print or '-' }}{% if doc.sleeve_colour %}<br><span style=\"font-weight:400; font-size:10px;\">{{ doc.sleeve_colour }}</span>{% endif %}</div>\n        </div>\n        {% if doc.collar_colour %}\n        <div class=\"cube\">\n            <div class=\"cube-k\">Collar Colour</div>\n            <div class=\"cube-v\">{{ doc.collar_colour }}</div>\n        </div>\n        {% endif %}\n        {% if doc.border_colour %}\n        <div class=\"cube\">\n            <div class=\"cube-k\">Border Colour</div>\n            <div class=\"cube-v\">{{ doc.border_colour }}</div>\n        </div>\n        {% endif %}\n    </div>\n\n    <!-- ORDER QUANTITY MIX (renamed from \"Cutting & Sewing Breakdown\") - full width -->\n    <p class=\"section-label\">Order Quantity Mix (Size &times; Sleeve)</p>\n    {% if doc.size_matrix %}\n    <table class=\"matrix-table\">\n        <thead>\n            <tr>\n                <th style=\"text-align:left; padding-left:8px;\">Sleeve Type</th>\n                {% for row in doc.size_matrix %}<th>{{ row.size_code }}</th>{% endfor %}\n                <th style=\"background:#3a3a3a;\">Total</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr>\n                <td style=\"text-align:left; padding-left:8px; font-weight:700;\">Half Sleeve</td>\n                {% for row in doc.size_matrix %}<td>{{ row.hs_qty or 0 }}</td>{% endfor %}\n                <td style=\"font-weight:700; background:#f1f3f4;\">{{ doc.size_matrix | sum(attribute='hs_qty') }}</td>\n            </tr>\n            <tr>\n                <td style=\"text-align:left; padding-left:8px; font-weight:700;\">Full Sleeve</td>\n                {% for row in doc.size_matrix %}<td>{{ row.fs_qty or 0 }}</td>{% endfor %}\n                <td style=\"font-weight:700; background:#f1f3f4;\">{{ doc.size_matrix | sum(attribute='fs_qty') }}</td>\n            </tr>\n            <tr>\n                <td style=\"text-align:left; padding-left:8px; font-weight:700;\">Sleeveless</td>\n                {% for row in doc.size_matrix %}<td>{{ row.sl_qty or 0 }}</td>{% endfor %}\n                <td style=\"font-weight:700; background:#f1f3f4;\">{{ doc.size_matrix | sum(attribute='sl_qty') }}</td>\n            </tr>\n        </tbody>\n        <tfoot>\n            <tr>\n                <td colspan=\"{{ doc.size_matrix | length + 1 }}\" style=\"text-align:right; padding-right:10px;\">Grand Total</td>\n                <td class=\"grand\">{{ doc.total_qty }} Pcs</td>\n            </tr>\n        </tfoot>\n    </table>\n    {% else %}\n    <span style=\"color:#94a3b8;\">No size/sleeve breakdown recorded.</span>\n    {% endif %}\n\n    <!-- NOTES - horizontal, full width -->\n    {% if doc.notes %}\n    <p class=\"section-label\">Notes</p>\n    <div style=\"font-size:11.5px; border:1px solid #dfe3e6; border-radius:6px; padding:10px 12px; background:#fafbfb;\">{{ doc.notes }}</div>\n    {% endif %}\n\n    <!-- DEPARTMENT SIGN-OFF - single horizontal line -->\n    <p class=\"section-label\">Department Sign-Off</p>\n    <div class=\"signoff-row\">\n        <div class=\"signoff-item\"><span class=\"checkbox\"></span> Sublimation / Printing: __________</div>\n        <div class=\"signoff-item\"><span class=\"checkbox\"></span> Cutting Floor: __________</div>\n        <div class=\"signoff-item\"><span class=\"checkbox\"></span> Sewing &amp; Assembly: __________</div>\n        <div class=\"signoff-item\"><span class=\"checkbox\"></span> QC &amp; Packaging: __________</div>\n    </div>\n\n    <div style=\"margin-top:14px; padding-top:8px; border-top:1px solid #dfe3e6; font-size:10px; color:#6b7580; display:flex; justify-content:space-between;\">\n        <span>BOM Routing: {{ doc.bom_strategy }}</span>\n        <span>Generated {{ frappe.utils.now_datetime().strftime('%d %b %Y, %H:%M') }} &mdash; vastraflaw</span>\n    </div>\n</div>\n",
 "font_size": 12,
 "margin_top": 10,
 "margin_bottom": 10,
 "margin_left": 10,
 "margin_right": 10,
 "page_number": "Hide",
 "align_labels_right": 0,
 "line_breaks": 0,
 "show_section_headings": 0,
 "raw_printing": 0,
 "print_format_builder": 0
}
