  },
  {
   "fieldname": "bom_intro_html",
   "fieldtype": "HTML",
   "options": "<div style='padding:10px 12px;border-left:3px solid #16a34a;background:#f0fdf4;border-radius:4px;margin-bottom:6px'><b>You never hand-build a BOM.</b> When a garment order needs manufacturing, VastraFlow reads the recipe from <b>VastraFlow BOM Rule</b>, builds a real ERPNext BOM for that exact specification, and reuses it for every future order with the same spec.<br><br>One recipe per product type replaces the fabric &times; collar &times; sleeve &times; size combinations you would otherwise create by hand.</div>"
  },
  {
   "fieldname": "bom_core_section",
   "fieldtype": "Section Break",
   "label": "Automatic BOM"
  },
  {
   "default": "1",
   "fieldname": "enable_auto_bom",
   "fieldtype": "Check",
   "label": "Enable Automatic BOM",
   "description": "Generate BOMs on demand from the order specification"
  },
  {
   "default": "1",
   "fieldname": "reuse_matching_bom",
   "fieldtype": "Check",
   "label": "Reuse Matching BOM",
   "description": "Strongly recommended. Reuses an existing auto-BOM with the same specification instead of creating a duplicate."
  },
  {
   "default": "1",
   "fieldname": "auto_submit_bom",
