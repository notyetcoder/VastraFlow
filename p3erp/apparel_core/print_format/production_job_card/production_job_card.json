{
 "doctype": "Print Format",
 "name": "Production Job Card",
 "module": "Apparel Core",
 "doc_type": "P3 Order Book",
 "print_format_type": "Jinja",
 "standard": "Yes",
 "disabled": 0,
 "custom_format": 1,
 "html": "<div class=\"jc-wrapper\" style=\"font-family: 'Inter', Arial, sans-serif; color: #111417; padding: 4px;\">\n    <style>\n        @page { size: A4; margin: 10mm; }\n        .jc-wrapper table.zone-table, .jc-wrapper table.matrix-table, .jc-wrapper table.signoff-table {\n            width: 100%; border-collapse: collapse; font-size: 11px; }\n        .jc-wrapper table.zone-table th, .jc-wrapper table.zone-table td,\n        .jc-wrapper table.matrix-table th, .jc-wrapper table.matrix-table td,\n        .jc-wrapper table.signoff-table td { border: 1px solid #dfe3e6; padding: 6px 4px; text-align: center; }\n        .jc-wrapper table.zone-table thead th, .jc-wrapper table.matrix-table thead th {\n            background: #111417; color: #fff; font-weight: 700; font-size: 10px; text-transform: uppercase; }\n        .jc-wrapper table.matrix-table tfoot td { background: #f1f3f4; font-weight: 800; }\n        .jc-wrapper table.matrix-table td.grand { background: #eaf4fe; color: #2490ef; }\n        .jc-wrapper .colour-chip { display: inline-block; width: 9px; height: 9px; border-radius: 2px;\n            margin-right: 4px; border: 1px solid rgba(0,0,0,.15); vertical-align: middle; }\n        .jc-wrapper .checkbox { display: inline-block; width: 12px; height: 12px; border: 1.5px solid #111417;\n            margin-right: 6px; vertical-align: middle; border-radius: 2px; }\n    </style>\n\n    <!-- Header -->\n    <div style=\"display:flex; justify-content:space-between; align-items:flex-start; border-bottom:3px solid #111417; padding-bottom:14px; margin-bottom:16px;\">\n        <div>\n            <h1 style=\"font-size:22px; font-weight:800; margin:0; letter-spacing:-0.01em;\">PRODUCTION JOB CARD</h1>\n            <div style=\"font-size:11px; color:#6b7580; letter-spacing:.04em; text-transform:uppercase; margin-top:2px;\">\n                P3 Order Book &middot; Apparel Manufacturing Floor Copy\n            </div>\n        </div>\n        <div style=\"text-align:right;\">\n            <div style=\"font-family:'JetBrains Mono', monospace; font-size:16px; font-weight:700; color:#2490ef;\">{{ doc.name }}</div>\n            <div style=\"font-size:11px; color:#6b7580; margin-top:3px;\">\n                Order: {{ doc.transaction_date }} &nbsp;&middot;&nbsp; Delivery: {{ doc.delivery_date }}\n            </div>\n        </div>\n    </div>\n\n    <!-- TOP BLOCK: Artwork (upper-left, large, no hover - this is a print/PDF, hover doesn't exist on paper)\n         beside Customer + Address + Contact + Dates -->\n    <table style=\"width:100%; border-collapse:separate; border-spacing:16px 0; margin-bottom:16px;\">\n    <tr>\n        <td style=\"width:30%; vertical-align:top;\">\n            <div style=\"border:1.5px solid #111417; border-radius:4px; padding:8px; text-align:center; background:#fafbfb;\">\n                <div style=\"font-size:9px; font-weight:800; letter-spacing:.05em; text-transform:uppercase; color:#6b7580; margin-bottom:6px;\">Artwork</div>\n                {% if doc.artwork_file %}\n                <img src=\"{{ doc.artwork_file }}\" style=\"width:100%; height:auto; display:block; object-fit:contain; border:1px solid #dfe3e6; border-radius:3px;\" />\n                {% else %}\n                <div style=\"padding:30px 10px; color:#94a3b8; font-size:11px;\">No Artwork Attached</div>\n                {% endif %}\n            </div>\n        </td>\n        <td style=\"width:70%; vertical-align:top;\">\n            <div style=\"border:1px solid #dfe3e6; border-radius:4px; padding:14px; height:100%;\">\n                <div style=\"font-size:16px; font-weight:800; margin-bottom:4px;\">{{ doc.customer }}</div>\n                {% if doc.address_display %}\n                <div style=\"font-size:11px; color:#6b7580; line-height:1.5; margin-bottom:6px;\">{{ doc.address_display }}</div>\n                {% endif %}\n                {% if doc.contact_display %}\n                <div style=\"font-size:11px; color:#6b7580; line-height:1.5; margin-bottom:10px;\">{{ doc.contact_display }}</div>\n                {% endif %}\n\n                <table style=\"width:100%; border-collapse:collapse; margin-top:8px;\">\n                    <tr>\n                        <td style=\"border:1px solid #dfe3e6; padding:7px 10px; width:25%;\">\n                            <div style=\"font-size:9px; text-transform:uppercase; color:#6b7580; font-weight:700;\">Order Date</div>\n                            <div style=\"font-size:12.5px; font-weight:700;\">{{ doc.transaction_date }}</div>\n                        </td>\n                        <td style=\"border:1px solid #dfe3e6; padding:7px 10px; width:25%;\">\n                            <div style=\"font-size:9px; text-transform:uppercase; color:#6b7580; font-weight:700;\">Delivery Date</div>\n                            <div style=\"font-size:12.5px; font-weight:700;\">{{ doc.delivery_date }}</div>\n                        </td>\n                        <td style=\"border:1px solid #dfe3e6; padding:7px 10px; width:25%;\">\n                            <div style=\"font-size:9px; text-transform:uppercase; color:#6b7580; font-weight:700;\">Sales Order</div>\n                            <div style=\"font-size:12.5px; font-weight:700;\">{{ doc.sales_order or 'Not yet linked' }}</div>\n                        </td>\n                        <td style=\"border:1px solid #111417; padding:7px 10px; width:25%; background:#111417;\">\n                            <div style=\"font-size:9px; text-transform:uppercase; color:#cfd3d7; font-weight:700;\">Total Qty</div>\n                            <div style=\"font-size:15px; font-weight:800; color:#7ec8ff;\">{{ doc.total_qty }} Pcs</div>\n                        </td>\n                    </tr>\n                </table>\n                <div style=\"margin-top:8px; font-size:11.5px;\"><strong>Product:</strong> {{ doc.product_type }}</div>\n            </div>\n        </td>\n    </tr>\n    </table>\n\n    <!-- Body: two columns -->\n    <table style=\"width:100%; border-collapse:separate; border-spacing:16px 0;\">\n    <tr>\n    <td style=\"width:42%; vertical-align:top;\">\n\n        <div style=\"border:1px solid #dfe3e6; border-radius:4px; padding:14px;\">\n            <p style=\"font-size:11px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; border-bottom:2px solid #111417; padding-bottom:6px; margin:0 0 10px;\">Garment Specification</p>\n            <table style=\"width:100%; font-size:12.5px;\">\n                <tr><td style=\"color:#6b7580; padding:5px 0; border-bottom:1px dashed #dfe3e6;\">Fabric</td><td style=\"font-weight:600; text-align:right; padding:5px 0; border-bottom:1px dashed #dfe3e6;\">{{ doc.fabric_label or doc.fabric or 'N/A' }}</td></tr>\n                <tr><td style=\"color:#6b7580; padding:5px 0; border-bottom:1px dashed #dfe3e6;\">Collar Type</td><td style=\"font-weight:600; text-align:right; padding:5px 0; border-bottom:1px dashed #dfe3e6;\">{{ doc.collar_label or doc.collar_type or 'Standard' }}</td></tr>\n                <tr><td style=\"color:#6b7580; padding:5px 0; border-bottom:1px dashed #dfe3e6;\">Stitching Type</td><td style=\"font-weight:600; text-align:right; padding:5px 0; border-bottom:1px dashed #dfe3e6;\">{{ doc.stitching or 'N/A' }}</td></tr>\n                <tr><td style=\"color:#6b7580; padding:5px 0;\">Buttons</td><td style=\"font-weight:600; text-align:right; padding:5px 0;\">{{ doc.button_qty or 0 }}</td></tr>\n            </table>\n        </div>\n\n        <div style=\"border:1px solid #dfe3e6; border-radius:4px; padding:14px; margin-top:14px;\">\n            <p style=\"font-size:11px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; border-bottom:2px solid #111417; padding-bottom:6px; margin:0 0 10px;\">Sublimation</p>\n            <span style=\"display:inline-block; font-size:11px; font-weight:700; padding:3px 10px; border-radius:999px; background:#eaf4fe; color:#2490ef; margin-bottom:10px;\">{{ doc.sublimation_type }}</span>\n            <table class=\"zone-table\">\n                <thead><tr><th>Front</th><th>Back</th><th>Sleeves</th></tr></thead>\n                <tbody>\n                    <tr>\n                        <td>{{ doc.front_print or '-' }}{% if doc.front_colour %}<br><span class=\"colour-chip\"></span>{{ doc.front_colour }}{% endif %}</td>\n                        <td>{{ doc.back_print or '-' }}{% if doc.back_colour %}<br><span class=\"colour-chip\"></span>{{ doc.back_colour }}{% endif %}</td>\n                        <td>{{ doc.sleeve_print or '-' }}{% if doc.sleeve_colour %}<br><span class=\"colour-chip\"></span>{{ doc.sleeve_colour }}{% endif %}</td>\n                    </tr>\n                </tbody>\n            </table>\n        </div>\n\n    </td>\n    <td style=\"width:58%; vertical-align:top;\">\n\n        <div style=\"border:1px solid #dfe3e6; border-radius:4px; padding:14px;\">\n            <p style=\"font-size:11px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; border-bottom:2px solid #111417; padding-bottom:6px; margin:0 0 10px;\">Cutting &amp; Sewing Breakdown</p>\n            {% if doc.size_matrix %}\n            <table class=\"matrix-table\">\n                <thead><tr><th>Size</th><th>H/S</th><th>F/S</th><th>S/L</th><th>Total</th></tr></thead>\n                <tbody>\n                    {% for row in doc.size_matrix %}\n                    <tr>\n                        <td>{{ row.size_code }}</td>\n                        <td>{{ row.hs_qty or 0 }}</td>\n                        <td>{{ row.fs_qty or 0 }}</td>\n                        <td>{{ row.sl_qty or 0 }}</td>\n                        <td style=\"font-weight:700;\">{{ row.total_qty or 0 }}</td>\n                    </tr>\n                    {% endfor %}\n                </tbody>\n                <tfoot>\n                    <tr><td colspan=\"4\">Grand Total</td><td class=\"grand\">{{ doc.total_qty }} Pcs</td></tr>\n                </tfoot>\n            </table>\n            {% else %}\n            <span style=\"color:#94a3b8;\">No size/sleeve breakdown recorded.</span>\n            {% endif %}\n\n            {% if doc.notes %}\n            <p style=\"font-size:11px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; border-bottom:2px solid #111417; padding-bottom:6px; margin:14px 0 10px;\">Notes</p>\n            <div style=\"font-size:11.5px; border:1px solid #dfe3e6; border-radius:4px; padding:8px 10px; background:#fafbfb;\">{{ doc.notes }}</div>\n            {% endif %}\n\n            <p style=\"font-size:11px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; border-bottom:2px solid #111417; padding-bottom:6px; margin:14px 0 10px;\">Department Sign-Off</p>\n            <table class=\"signoff-table\">\n                <tr><td style=\"font-weight:700; text-align:left; width:45%;\"><span class=\"checkbox\"></span>Sublimation / Printing</td><td style=\"text-align:left;\">Sign: ______________</td></tr>\n                <tr><td style=\"font-weight:700; text-align:left;\"><span class=\"checkbox\"></span>Cutting Floor</td><td style=\"text-align:left;\">Sign: ______________</td></tr>\n                <tr><td style=\"font-weight:700; text-align:left;\"><span class=\"checkbox\"></span>Sewing &amp; Assembly</td><td style=\"text-align:left;\">Sign: ______________</td></tr>\n                <tr><td style=\"font-weight:700; text-align:left;\"><span class=\"checkbox\"></span>QC &amp; Packaging</td><td style=\"text-align:left;\">Sign: ______________</td></tr>\n            </table>\n        </div>\n\n    </td>\n    </tr>\n    </table>\n\n    <div style=\"margin-top:18px; padding-top:10px; border-top:1px solid #dfe3e6; font-size:10px; color:#6b7580; display:flex; justify-content:space-between;\">\n        <span>BOM Routing: {{ doc.bom_strategy }}</span>\n        <span>Generated {{ frappe.utils.now_datetime().strftime('%d %b %Y, %H:%M') }} &mdash; P3 Order Book</span>\n    </div>\n</div>\n",
 "font_size": 12,
 "margin_top": 10,
 "margin_bottom": 10,
 "margin_left": 10,
 "margin_right": 10,
 "page_number": "Hide",
 "align_labels_right": 0,
 "line_breaks": 0,
 "show_section_headings": 0,
 "raw_printing": 0,
 "print_format_builder": 0
}
