   "fieldname": "scope_note_html",
   "fieldtype": "HTML",
   "options": "<div style='padding:8px 10px;background:#f3f4f6;border-radius:4px;font-size:12px;color:#374151'>These rules apply <b>only</b> to Sales Orders with <b>Is Garment Order</b> ticked. Regular sales flow is untouched.</div>"
  },
  {
   "fieldname": "validation_section",
   "fieldtype": "Section Break",
   "label": "Validation"
  },
  {
   "default": "1",
   "fieldname": "block_submit_without_price",
   "fieldtype": "Check",
   "label": "Block Submit Without Price",
   "description": "Stops submission when no Price Matrix entry matches. Turn off to allow manual rates."
  },
  {
   "default": "Warn Only",
