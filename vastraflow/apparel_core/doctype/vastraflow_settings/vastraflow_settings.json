 "fields": [
  {
   "fieldname": "tab_general",
   "fieldtype": "Tab Break",
   "label": "General"
  },
  {
   "default": "1",
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enable VastraFlow",
   "description": "Master switch. When off, VastraFlow adds no behaviour to Sales Orders."
  },
  {
   "fieldname": "intro_html",
   "fieldtype": "HTML",
   "options": "<div style='padding:10px 12px;border-left:3px solid #7c3aed;background:#f8f7ff;border-radius:4px;margin:6px 0 2px'><b>VastraFlow</b> extends the standard ERPNext Sales Order with garment specifications, size/sleeve quantity matrices, matrix-based pricing and automatic BOM generation.<br><br>Nothing here changes how a normal (non-garment) Sales Order behaves &mdash; VastraFlow logic only runs on orders flagged <b>Is Garment Order</b>.</div>"
  },
  {
   "fieldname": "branding_section",
   "fieldtype": "Section Break",
   "label": "Branding"
  },
  {
   "fieldname": "company_logo",
   "fieldtype": "Attach Image",
   "label": "Company Logo",
   "description": "Shown on the Production Job Card print format"
  },
  {
   "fieldname": "column_break_brand",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "default_company",
   "fieldtype": "Link",
   "label": "Default Company",
   "options": "Company"
  },
  {
   "fieldname": "setup_section",
   "fieldtype": "Section Break",
   "label": "Setup"
  },
  {
   "fieldname": "setup_html",
   "fieldtype": "HTML",
   "options": "<div id='vf-setup-status' style='color:#6b7280'>Loading setup status&hellip;</div>"
  },

